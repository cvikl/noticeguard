# LLM provider: gemini | anthropic | claude_cli
# claude_cli shells out to the local `claude -p` CLI (uses your Claude Code login; no key needed).
# If LLM_PROVIDER is unset, NoticeGuard picks gemini when GEMINI_API_KEY is set, anthropic when
# ANTHROPIC_API_KEY is set, otherwise claude_cli when the `claude` binary is on PATH.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NOTICEGUARD_CACHE=1
# Optional: LLM prose smoothing of drafts (post-check still runs on the smoothed text)
NOTICEGUARD_SMOOTH_DRAFT=0
