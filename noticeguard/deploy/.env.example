# Copy to deploy/.env before running publish.sh.
# The committed cache (cache/llm) was produced with provider=claude_cli model=sonnet; the cache key includes both,
# so keep these values for the demo cases to run offline. Live uploads of new documents need a real provider:
# set LLM_PROVIDER=gemini + GEMINI_API_KEY (or anthropic + ANTHROPIC_API_KEY) and re-run `make seed` to rebuild the cache.
LLM_PROVIDER=claude_cli
LLM_MODEL=sonnet
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NOTICEGUARD_CACHE=1
